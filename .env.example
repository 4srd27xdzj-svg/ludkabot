TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_botfather

# ID чатов, где бот имеет право работать. Несколько ID пишутся через запятую.
# Пример группы: -1001234567890
ALLOWED_CHAT_IDS=

# ID владельцев, которым доступны owner-команды и уведомления о выигрышах.
# Несколько ID пишутся через запятую.
OWNER_USER_IDS=

# На Bothost лучше хранить базу в /app/data, чтобы она не сбрасывалась при перезапуске.
DATA_DIR=/app/data

# Можно не задавать. Если задано, имеет приоритет над DATA_DIR.
# DATABASE_PATH=/app/data/twist_ludka.sqlite3
